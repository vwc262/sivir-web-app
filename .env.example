# Configuración del sitio de monitoreo. Copiar a `.env` y rellenar.
# El `.env` NO se versiona (ver .gitignore): el token de Mapbox es un secreto.

# ─── Servicios de la plataforma ──────────────────────────────────────────────
# sivir-rest-core: dominio, telemetría e historial de chat.
VITE_CORE_URL=http://localhost:8082
# sivir-realtime-hub: WebSocket de alertas en vivo. Puerto 8083, no 8080:
# ese lo ocupa Keycloak (ver VITE_KEYCLOAK_AUTHORITY abajo).
VITE_HUB_WS_URL=ws://localhost:8083/ws

# ─── Autenticación ───────────────────────────────────────────────────────────
# OIDC real (Authorization Code + PKCE) contra Keycloak. Sin bypass de ningún tipo.
VITE_KEYCLOAK_AUTHORITY=http://localhost:8080/realms/SecurityFramework
VITE_KEYCLOAK_CLIENT_ID=sivir-web-app
VITE_KEYCLOAK_SCOPE=openid profile email
# Por defecto se derivan del origin del navegador:
# VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5174/auth/callback
# VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:5174/

# Claims del token. Deben coincidir con HUB_CONDOMINIO_CLAIM y HUB_ROLES_CLAIM
# del realtime-hub: el primero decide a qué canal de alertas se suscribe el sitio.
# VITE_CONDOMINIO_CLAIM=condominio_id
# VITE_ROLES_CLAIM=roles

# ─── Mapa ────────────────────────────────────────────────────────────────────
# Sin token el sitio usa el proveedor OSM (no requiere credenciales).
VITE_MAPBOX_TOKEN="pk.eyJ1IjoidWxpc2VzZ20tMDIiLCJhIjoiY2xzNTEwaXZ5MTE2NzJwcGJhNmdmM2MyMSJ9.xIk1PS-VJzW_WZGiv24Vow"
VITE_MAPBOX_STYLE=mapbox://styles/ulisesgm-02/cmr2n441b004l01s7138421fm

# ─── Cámaras ─────────────────────────────────────────────────────────────────
# No hay nada que configurar aquí: la URL HLS de cada cámara la construye el
# core (VIDEO_EDGE_BASE_URL) y llega en el inventario.
